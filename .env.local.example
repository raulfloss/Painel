# =========================================================
#  Variáveis de ambiente do Painel de Demandas
#  Copie este arquivo para ".env.local" e preencha os valores.
# =========================================================

# --- Supabase (obrigatório) ---
# Encontre em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave de serviço (NUNCA exponha no front-end). Usada só no servidor.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- E-mail automático via Resend (opcional) ---
# Crie grátis em https://resend.com e gere uma API Key.
# Se deixar em branco, o sistema funciona normalmente, apenas sem enviar e-mails.
RESEND_API_KEY=
# Remetente verificado no Resend (ex.: "Painel <demandas@suaempresa.com>").
# Para testes pode usar o domínio padrão: onboarding@resend.dev
EMAIL_FROM=Painel de Demandas <onboarding@resend.dev>
# E-mail do gestor de TI que recebe aviso de toda nova demanda (você).
EMAIL_ADMIN=adv.anadutra@gmail.com

# URL pública do app (usada nos links dos e-mails). Em produção: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
